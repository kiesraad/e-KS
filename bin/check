#!/bin/bash

set -euo pipefail

export MEMORY_SERVE_QUIET=1

# check postgres is running
if docker compose exec -T psql pg_isready -U eks; then
    cargo sqlx migrate run --database-url postgres://eks@localhost/eks
fi

# rust
cargo check --all-features
cargo +nightly fmt --all -- --config imports_granularity="Crate"
cargo clippy --all-targets --all-features -- -D warnings
cargo test --all-features

# typescript
./bin/biome check --fix ./frontend
./bin/biome check --fix ./playwright/tests

# html
docker run --rm \
          -v ./src/app:/work/templates/app \
          -v ./src/error:/work/templates/error \
          djlint \
          djlint --ignore=H025 --lint --extension=html --check --indent=2 templates

# generic
./bin/check_newline
./bin/update_locales
