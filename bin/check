#!/bin/bash

set -euo pipefail

export MEMORY_SERVE_QUIET=1

FULL=false
for arg in "$@"; do
    case "$arg" in
        --full) FULL=true ;;
        -h|--help)
            echo "Usage: bin/check [--full]"
            echo
            echo "  --full  Run the Rust checks for the whole workspace with"
            echo "          --all-features, and also build the API docs."
            exit 0
            ;;
        *)
            echo "Unknown argument: $arg" >&2
            echo "Usage: bin/check [--full]" >&2
            exit 1
            ;;
    esac
done

# rust
SCOPE=()
if [ "$FULL" = true ]; then
    SCOPE=(--workspace --all-features)
fi

echo "==> Rust checks"
cargo check ${SCOPE[@]+"${SCOPE[@]}"}
cargo +nightly fmt --all -- --config imports_granularity="Crate"
cargo clippy --all-targets ${SCOPE[@]+"${SCOPE[@]}"} -- -D warnings
cargo test ${SCOPE[@]+"${SCOPE[@]}"}

if [ "$FULL" = true ]; then
    echo "==> Rust docs"
    cargo doc --workspace --no-deps --all-features --document-private-items
fi

# typescript
./bin/biome check --fix ./frontend
./bin/biome check --fix ./playwright/tests

# html
docker run --rm -v ./src:/work/templates djlint

# generic
./bin/check_newline
./bin/update_locales
