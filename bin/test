#!/bin/bash

set -euo pipefail

export MEMORY_SERVE_QUIET=1

./bin/esbuild --bundle frontend/index.ts \
    --outdir=frontend/static \
    --minify \
    --sourcemap \
    --define:IS_PRODUCTION=true \
    --loader:.woff2=file \
    --loader:.svg=file \
    --public-path=/static/

cargo build \
    --locked \
    --no-default-features \
    --features memory-serve,fixtures,dev-features,tvs-mock \
    --release \
    --bin eks

pushd playwright
    docker compose build --quiet
    docker compose run --rm --quiet-pull --quiet-build playwright
popd
